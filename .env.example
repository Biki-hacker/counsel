# =================================================================
# COUNSEL — ENVIRONMENT CONFIGURATION
# =================================================================

# Server
PORT=8080
ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
DEBUG_MODE=false

# Dual OpenRouter API Keys (Server-side secrets, NEVER exposed to client)
OPENROUTER_API_KEY_PRIMARY=
OPENROUTER_API_KEY_SECONDARY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Verified Model Registry (OpenRouter)
MODEL_GOOGLE_NORMAL=google/gemma-4-26b-a4b-it:free
MODEL_GOOGLE_THINKING=google/gemma-4-31b-it:free
MODEL_NVIDIA_NORMAL=nvidia/nemotron-3-super-120b-a12b:free
MODEL_NVIDIA_THINKING=nvidia/nemotron-3-ultra-550b-a55b:free
MODEL_NVIDIA_OMNI=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Upstash Redis (For distributed weighted quotas, circuit breakers, and rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Firebase Auth & Firestore Persistence
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Supabase Auth (Email / Password)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Usage Quotas & Document Limits
MAX_DOCUMENT_SIZE_BYTES=20971520 # 20MB
MAX_PAGE_COUNT=100
DAILY_QUOTA_ALLOWANCE=100
WEIGHT_BASE_TEXT=1
WEIGHT_THINKING_MULT=2
WEIGHT_EXPERT_MULT=3
WEIGHT_COMPARE_MULT=3
